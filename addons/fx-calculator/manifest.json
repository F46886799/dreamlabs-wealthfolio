{
  "id": "fx-calculator",
  "name": "FX Calculator",
  "version": "1.0.0",
  "description": "Real-time exchange rate calculator using external APIs",
  "author": "Community",
  "main": "dist/addon.js",
  "sdkVersion": "^1.0.0",
  "enabled": true,
  "permissions": [
    {
      "category": "exchangeRates",
      "functions": ["getAll", "add", "update"],
      "purpose": "Read and update exchange rates"
    },
    {
      "category": "secrets",
      "functions": ["get", "set"],
      "purpose": "Store and read external API keys securely"
    },
    {
      "category": "ui",
      "functions": ["sidebar.addItem", "router.add"],
      "purpose": "Add sidebar navigation and routing"
    }
  ]
}